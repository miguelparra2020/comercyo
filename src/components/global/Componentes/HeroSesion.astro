---
import LogoAvif from '@img/logoCompany.avif'
import LogoWebp from '@img/logoCompany.webp'
import LogoJpg from '@img/logoCompany.jpg'
import LogoPng from '@img/logoCompany.png'
---

<section class="pt-10 flex  flex-col items-center overflow-hidden bg-neutral-50">

  <div class="mx-auto px-6 relative z-10">
    <div class="max-w-5xl mx-auto text-center">

      <!-- Brand -->
      <div class="flex flex-col items-center mb-8">
        <picture>
  <source srcset={LogoAvif} type="image/avif" />
  <source srcset={LogoWebp} type="image/webp" />
  <source srcset={LogoJpg} type="image/jpeg" />
  <source srcset={LogoPng} type="image/png" />

  <img
    src={LogoJpg}
    alt="Comercyo® – Plataforma de comercio digital y e-commerce logo"
    class="w-50 h-50 mb-3 rounded-full object-cover shadow-lg"
    loading="eager"
    decoding="async"
  />
</picture>
        <span class="text-xl font-semibold tracking-tight text-neutral-900">
          Comercyo® – Plataforma de comercio digital y e-commerce<span class="text-indigo-600"></span>
        </span>
      </div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full bg-white border border-neutral-200 text-sm text-neutral-600 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        SEO • Velocidad • Escalabilidad
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight mb-6 text-balance text-neutral-900">
        No vendes más<br />
        <span class="text-indigo-600">
          porque no te encuentran.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-xl sm:text-2xl text-neutral-600 max-w-3xl mx-auto mb-10 text-pretty">
        Creamos landing pages ultrarrápidas y optimizadas para Google,
        listas para evolucionar a ecommerce, CRM y sistemas empresariales altamente competitivos, pero lo mejor a precios insuperables
      </p>

      <!-- Value points -->
      <div class="flex flex-col sm:flex-row justify-center gap-6 mb-12 text-neutral-700 text-base">
        <span>⚡ SEO técnico real</span>
        <span>🚀 100/100 en Lighthouse</span>
        <span>📈 Escalable desde el día uno</span>
      </div>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="https://api.whatsapp.com/send?phone=573217028011&text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n"
          target="_blank"
          class="px-10 py-4 rounded-lg text-lg font-semibold
                 bg-indigo-600 text-white
                 hover:bg-indigo-500
                 transition-all shadow-lg shadow-indigo-600/25"
        >
          Quiero aparecer en Google
        </a>

        <a
          href="https://drive.google.com/file/d/1O13Kd24aQYdcxA9OEDg85mwHyhLsk827/view?usp=sharing"
          target="_blank"
          class="px-10 py-4 rounded-lg text-lg font-semibold
                 border border-neutral-300 bg-white
                 hover:bg-neutral-100 transition-all"
        >
          Ver la estrategia
        </a>
      </div>

    </div>
  </div>
<br>
  <!-- Scroll indicator -->
  <div class="bottom-10 left-1/2 -translate-x-1/2 animate-bounce text-neutral-400">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
<br>
</section>
