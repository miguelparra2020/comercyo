---
import HeroAvif from '@img/Comercyo®hero.avif'
import HeroWebp from '@img/Comercyo®hero.webp'
import HeroJpg from '@img/Comercyo®hero.jpg'
import HeroPng from '@img/Comercyo®hero.png'
---

{/* Hero Visual - Abstract Platform Mockup */}
<div class="mx-4 my-12 sm:mx-8 md:m-24">
  <div class="relative mx-auto max-w-5xl">

    {/* Glow background */}
    <div class="absolute inset-0 bg-gradient-to-r from-primary/20 to-accent/20 blur-3xl" />

    {/* Card */}
    <div class="relative rounded-xl border border-border bg-card p-3 sm:p-4 shadow-2xl">

      {/* Image wrapper */}
      <div class="aspect-video w-full rounded-lg bg-muted overflow-hidden">
        <picture>
          <source srcset={HeroAvif} type="image/avif" />
          <source srcset={HeroWebp} type="image/webp" />
          <source srcset={HeroJpg} type="image/jpeg" />
          <source srcset={HeroPng} type="image/png" />

          <img
            src={HeroJpg}
            alt="Comercyo® – Desarrollo web de comercios digitales y e-commerces"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>

    </div>
  </div>
</div>
