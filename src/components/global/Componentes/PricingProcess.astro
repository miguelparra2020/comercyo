---

---

<section class="min-h-screen bg-white">

  <!-- Hero -->
  <section class=" px-6">
    <div class="max-w-6xl mx-auto text-center">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-600 text-sm font-semibold border border-indigo-100 mb-8">
        📌 Proceso claro, pagos justos
      </span>
    </div>
  </section>

  <!-- Header -->
<div class="max-w-3xl mx-auto text-center mb-20">

  <!-- Pricing highlight -->
  <div class="mb-8">
  <p class="text-sm uppercase tracking-wide text-gray-700 mb-2">
    Precio especial de lanzamiento
  </p>

  <div class="flex justify-center items-center gap-4 flex-wrap">
    <span class="text-2xl text-gray-600 line-through font-semibold">
      $1.399.000 COP
    </span>

    <span class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-emerald-600 to-emerald-500 bg-clip-text text-transparent">
      $599.900 COP
    </span>
  </div>

  <p class="text-sm text-gray-700 mt-2">
    Pago único por diseño y desarrollo
  </p>
</div>


</div>

  <!-- Steps -->
  <section class=" px-6">
    <div class="max-w-5xl mx-auto space-y-10">

      <!-- Paso 1 -->
      <div class="p-8 bg-white border border-gray-200 rounded-2xl hover:shadow-xl transition">
        <div class="flex gap-6">
          <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xl font-bold">
            1
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              Inicio del proyecto
            </h3>

            <span class="inline-block px-4 py-2 rounded-lg bg-indigo-50 text-indigo-700 font-semibold mb-4">
              Costo: $0
            </span>

            <ul class="space-y-2 text-gray-600 mb-4">
              <li>✔ Analizamos tu negocio y necesidades reales</li>
              <li>✔ Creamos la base PWA con logo y nombre</li>
              <li>✔ Te entregamos un link de pruebas en tiempo real</li>
            </ul>

            <div class="bg-indigo-50 border-l-4 border-indigo-600 p-4 rounded-lg font-medium text-gray-800">
              👉 En esta etapa no pagas nada
            </div>
          </div>
        </div>
      </div>

      <!-- Paso 2 -->
      <div class="p-8 bg-white border border-gray-200 rounded-2xl hover:shadow-xl transition">
        <div class="flex gap-6">
          <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xl font-bold">
            2
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              Diseño y desarrollo personalizado
            </h3>

            <span class="inline-block px-4 py-2 rounded-lg bg-indigo-100 mb-4">
  <span class="block text-sm text-gray-700">
    Costo total
  </span>
  <span class="text-2xl font-bold text-gray-900">
    $600.000 COP
  </span>
</span>


            <p class="text-gray-600 mb-4">
              Cuando ya ves la base funcionando y vamos a personalizar completamente el sitio:
            </p>

            <div class="bg-indigo-100 border border-indigo-600 rounded-xl p-5 text-indigo-900 font-bold text-2xl">
              💰 Primer pago: $300.000 COP
            </div>

            <p class="text-sm text-gray-500 mt-3 italic">
              Pagas solo cuando ya ves resultados reales.
            </p>
          </div>
        </div>
      </div>

      <!-- Paso 3 -->
      <div class="p-8 bg-white border border-gray-200 rounded-2xl hover:shadow-xl transition">
        <div class="flex gap-6">
          <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xl font-bold">
            3
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-gray-900 mb-3">
              Entrega final
            </h3>

            <p class="text-gray-600 mb-4">
              Finalizamos el diseño, dejamos todo optimizado y listo para usar.
            </p>

            <div class="bg-indigo-100 border border-indigo-600 rounded-xl p-5">
              <div class="text-2xl font-bold text-indigo-900">
                💰 Pago final: $300.000 COP
              </div>
              <div class="mt-2 text-gray-800 font-medium">
                🎁 Incluye dominio .com GRATIS por 1 año
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mantenimiento -->
      <div class="p-8 bg-gray-50 border border-gray-200 rounded-2xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">
          Costos posteriores
        </h3>

        <div class="grid sm:grid-cols-2 gap-6">
          <div class="p-5 bg-white rounded-xl border">
            <p class="text-gray-600 mb-2">
              Hosting, base de datos, SSL y soporte
            </p>
            <p class="text-2xl font-bold text-gray-900">
              $30.000 COP <span class="text-sm text-gray-500">/ mes</span>
            </p>
          </div>

          <div class="p-5 bg-white rounded-xl border">
            <p class="text-gray-600 mb-2">
              Renovación dominio .com
            </p>
            <p class="text-2xl font-bold text-gray-900">
              $100.000 COP <span class="text-sm text-gray-500">/ año aprox.</span>
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-6">
    <div class="max-w-2xl mx-auto text-center space-y-4">
      <a
        href="https://api.whatsapp.com/send?phone=573217028011&text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n"
        target="_blank"
        class="inline-flex justify-center items-center w-full sm:w-auto px-8 py-4 text-lg font-semibold rounded-xl
               bg-gradient-to-r from-indigo-600 to-blue-600 text-white hover:opacity-90 transition"
      >
        👉 Quiero ver cómo sería mi proyecto
      </a>

      <a
        href="https://api.whatsapp.com/send?phone=573217028011&text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n"
        target="_blank"
        class="inline-flex justify-center items-center w-full sm:w-auto px-8 py-4 text-lg font-semibold rounded-xl
               border border-gray-300 text-gray-700 hover:border-indigo-500 hover:text-indigo-600 transition"
      >
        👉 Hablar con un asesor
      </a>
    </div>
  </section>

</section>
