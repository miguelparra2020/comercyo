---
const problems = [
  {
    icon: "🧩",
    title: "Un rompecabezas de herramientas",
    description:
      "Landing por un lado, ecommerce en otro, CRM aparte. Todo desconectado y dependiendo de procesos manuales."
  },
  {
    icon: "💸",
    title: "Gastos que no paran de crecer",
    description:
      "Pagas múltiples suscripciones mensuales sin obtener más control, velocidad ni mejores resultados."
  },
  {
    icon: "📉",
    title: "Procesos sin seguimiento",
    description:
      "Clientes dispersos, ventas que se enfrían y decisiones tomadas sin datos claros."
  },
  {
    icon: "🔒",
    title: "Dependencia de terceros",
    description:
      "Plataformas que cambian precios, reglas o funciones y afectan directamente tu negocio."
  }
];
---

<section id="problema" class="py-28 bg-neutral-50 relative overflow-hidden">
  <div class="container mx-auto px-6">

    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-20">
      <span class="inline-block mb-4 text-4xl font-semibold text-indigo-600">
        El problema
      </span>

      <h2 class="text-4xl sm:text-5xl font-bold mb-6 text-neutral-900 text-balance">
        El caos digital que frena tu negocio
      </h2>

      <p class="text-xl text-neutral-600 text-pretty">
        Crecer en digital no debería sentirse como apagar incendios todos los días.
      </p>
    </div>

    <!-- Problems grid -->
    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {problems.map((problem) => (
        <div
          class="group p-8 bg-white border border-neutral-200 rounded-2xl
                 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >

          <!-- Icon -->
          <div
            class="w-12 h-12 mb-6 flex items-center justify-center rounded-xl
                   bg-indigo-50 text-2xl group-hover:bg-indigo-600
                   group-hover:text-white transition"
          >
            {problem.icon}
          </div>

          <!-- Title -->
          <h3 class="text-xl font-semibold mb-3 text-neutral-900">
            {problem.title}
          </h3>

          <!-- Description -->
          <p class="text-neutral-600 leading-relaxed">
            {problem.description}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>

