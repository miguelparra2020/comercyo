---
import LayoutGeneral from '@layout/LayoutGeneral/LayoutGeneral.astro';

interface CardProps {
  title: string;
  description: string;
  href: string;
  variant?: 'primary' | 'secondary';
  icon: 'user' | 'settings';
}

const cards: CardProps[] = [
  {
    title: 'Mi Perfil',
    description:
      'Visualiza y gestiona tu información personal, preferencias y configuración de cuenta.',
    href: '/',
    variant: 'secondary',
    icon: 'user',
  },
  {
    title: 'Panel Administrativo',
    description:
      'Accede a configuraciones avanzadas, gestión del sistema y herramientas de administración.',
    href: '/',
    variant: 'secondary',
    icon: 'settings',
  },
];

const stylesByVariant = (variant: 'primary' | 'secondary') => {
  const isPrimary = variant === 'primary';

  return {
    borderHover: isPrimary ? 'hover:border-blue-300' : 'hover:border-zinc-400',
    iconBg: isPrimary
      ? 'bg-blue-100 group-hover:bg-blue-200'
      : 'bg-zinc-100 group-hover:bg-zinc-200',
    iconColor: isPrimary ? 'text-blue-600' : 'text-zinc-600',
    buttonClass: isPrimary
      ? 'bg-blue-600 text-white hover:bg-blue-700'
      : 'border border-zinc-300 text-zinc-700 hover:bg-zinc-100',
  };
};
---

<LayoutGeneral title="Bienvenido a la Plataforma">
  <main class="min-h-screen flex flex-col items-center justify-center bg-zinc-50 px-4 py-12">
    <!-- Título y descripción -->
    <div class="text-center max-w-2xl mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 mb-4 text-balance">
        Bienvenido
      </h1>
      <p class="text-lg text-zinc-600">
        Elige cómo deseas continuar. Puedes acceder a tu perfil personal o gestionar el sistema desde el panel administrativo.
      </p>
    </div>

    <!-- Cards -->
    <div class="flex flex-col md:flex-row gap-6 w-full max-w-3xl">
      {cards.map((card) => {
        const {
          borderHover,
          iconBg,
          iconColor,
          buttonClass,
        } = stylesByVariant(card.variant ?? 'primary');

        return (
          <div
            class:list={`group flex-1 bg-white border border-zinc-200 rounded-xl p-8 shadow-sm hover:shadow-lg ${borderHover} transition-all duration-300`}
          >
            <div class="flex flex-col items-center text-center gap-4">
              <!-- Icono -->
              <div
                class:list={`w-16 h-16 rounded-full ${iconBg} flex items-center justify-center transition-colors duration-300`}
              >
                {card.icon === 'user' ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class:list={`w-8 h-8 ${iconColor}`}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                ) : (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class:list={`w-8 h-8 ${iconColor}`}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                )}
              </div>

              <!-- Texto -->
              <div>
                <h2 class="text-xl font-semibold text-zinc-900 mb-2">
                  {card.title}
                </h2>
                <p class="text-zinc-600 text-sm">{card.description}</p>
              </div>

              <!-- Botón -->
              <a
                href={card.href}
                class:list={`mt-2 inline-flex items-center justify-center px-4 py-2 font-medium rounded-md transition-colors ${buttonClass}`}
              >
                Ingresar
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </main>
</LayoutGeneral>
